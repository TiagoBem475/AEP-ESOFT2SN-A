 * Matheus Gabriel dos Santos Meneguete, Tiago da Silva Bem, Pedro Henrique Machea
 *
 * Registra apenas dados COLETIVOS e FICTICIOS sobre as acoes.
 * O sistema nao faz diagnostico, triagem ou atendimento psicologico.
 *
 * Compilar: gcc -Wall -Wextra -std=c99 -o mente_em_foco src/main.c
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_ACOES 50

typedef struct {
    int  codigo;
    char escola[60];
    int  tema;            /* indice do vetor TEMAS */
    int  tipo;            /* indice do vetor TIPOS */
    char data[11];        /* DD/MM/AAAA */
    char responsavel[60];
    int  previstos;       /* participantes previstos */
    int  presentes;       /* participantes efetivos (so quando realizada) */
    int  situacao;        /* 1 planejada, 2 realizada, 3 cancelada */
} Acao;

const char *TEMAS[] = {"", "Bullying", "Autoestima", "Emocoes", "Convivencia", "Ansiedade e estresse"};
const char *TIPOS[] = {"", "Palestra", "Roda de conversa", "Oficina", "Campanha"};
const char *SITUACAO[] = {"", "Planejada", "Realizada", "Cancelada"};

/* Le uma linha que nao pode ficar vazia. Encerra se a entrada acabar. */
void lerTexto(const char *msg, char *destino, int tamanho) {
    do {
        printf("%s", msg);
        if (fgets(destino, tamanho, stdin) == NULL) {
            printf("\nEntrada encerrada. Ate logo!\n");
            exit(0);
        }
        if (strchr(destino, '\n') == NULL) {          /* descarta o excesso */
            int c;
            while ((c = getchar()) != '\n' && c != EOF) {}
        }
        destino[strcspn(destino, "\n")] = '\0';
        if (destino[0] == '\0')
            printf("Campo obrigatorio. Nao pode ficar em branco.\n");
    } while (destino[0] == '\0');
}

/* Le um inteiro entre min e max, repetindo ate ser valido. */
int lerNumero(const char *msg, int min, int max) {
    char linha[32], *fim;
    long n;
    while (1) {
        lerTexto(msg, linha, sizeof linha);
        n = strtol(linha, &fim, 10);
        if (*fim == '\0' && n >= min && n <= max)
            return (int) n;
        printf("Valor invalido. Digite um numero de %d a %d.\n", min, max);
    }
}

int dataValida(const char *d) {
    int dia, mes, ano;
    if (strlen(d) != 10 || d[2] != '/' || d[5] != '/') return 0;
    if (sscanf(d, "%2d/%2d/%4d", &dia, &mes, &ano) != 3) return 0;
    return dia >= 1 && dia <= 31 && mes >= 1 && mes <= 12 && ano >= 2026;
}

int buscarPorCodigo(Acao acoes[], int total, int codigo) {
    for (int i = 0; i < total; i++)
        if (acoes[i].codigo == codigo) return i;
    return -1;
}

void exibirAcao(Acao a) {
    printf("[%d] %s | %s - %s | %s | Resp.: %s | Previstos: %d",
           a.codigo, a.escola, TIPOS[a.tipo], TEMAS[a.tema], a.data, a.responsavel, a.previstos);
    if (a.situacao == 2) printf(" | Presentes: %d", a.presentes);
    printf(" | %s\n", SITUACAO[a.situacao]);
}

int cadastrarAcao(Acao acoes[], int total) {
    Acao nova;
    if (total >= MAX_ACOES) {
        printf("Limite de %d acoes atingido.\n", MAX_ACOES);
        return total;
    }
    nova.codigo = lerNumero("Codigo da acao: ", 1, 99999);
    while (buscarPorCodigo(acoes, total, nova.codigo) != -1) {
        printf("Codigo ja cadastrado. Informe outro.\n");
        nova.codigo = lerNumero("Codigo da acao: ", 1, 99999);
    }
    lerTexto("Escola: ", nova.escola, sizeof nova.escola);
    printf("Temas: 1-Bullying 2-Autoestima 3-Emocoes 4-Convivencia 5-Ansiedade e estresse\n");
    nova.tema = lerNumero("Tema: ", 1, 5);
    printf("Tipos: 1-Palestra 2-Roda de conversa 3-Oficina 4-Campanha\n");
    nova.tipo = lerNumero("Tipo de atividade: ", 1, 4);
    lerTexto("Data prevista (DD/MM/AAAA): ", nova.data, sizeof nova.data);
    while (!dataValida(nova.data)) {
        printf("Data invalida. Use o formato DD/MM/AAAA.\n");
        lerTexto("Data prevista (DD/MM/AAAA): ", nova.data, sizeof nova.data);
    }
    lerTexto("Responsavel: ", nova.responsavel, sizeof nova.responsavel);
    nova.previstos = lerNumero("Participantes previstos: ", 1, 5000);
    nova.presentes = 0;
    nova.situacao = 1;
    acoes[total] = nova;
    printf("Acao %d cadastrada com sucesso!\n", nova.codigo);
    return total + 1;
}

void listarAcoes(Acao acoes[], int total) {
    if (total == 0) { printf("Nenhuma acao cadastrada.\n"); return; }
    printf("\n===== ACOES CADASTRADAS (%d) =====\n", total);
    for (int i = 0; i < total; i++) exibirAcao(acoes[i]);
}

void pesquisarPorEscola(Acao acoes[], int total) {
    char trecho[60];
    int achou = 0;
    if (total == 0) { printf("Nenhuma acao cadastrada.\n"); return; }
    lerTexto("Nome (ou parte) da escola: ", trecho, sizeof trecho);
    for (int i = 0; i < total; i++)
        if (strstr(acoes[i].escola, trecho) != NULL) { exibirAcao(acoes[i]); achou = 1; }
    if (!achou) printf("Nenhuma acao encontrada para \"%s\".\n", trecho);
}

void atualizarSituacao(Acao acoes[], int total) {
    int pos;
    if (total == 0) { printf("Nenhuma acao cadastrada.\n"); return; }
    pos = buscarPorCodigo(acoes, total, lerNumero("Codigo da acao: ", 1, 99999));
    if (pos == -1) { printf("Acao nao encontrada.\n"); return; }
    acoes[pos].situacao = lerNumero("Nova situacao (1-Planejada 2-Realizada 3-Cancelada): ", 1, 3);
    acoes[pos].presentes = 0;
    if (acoes[pos].situacao == 2)
        acoes[pos].presentes = lerNumero("Participantes presentes: ", 0, 5000);
    printf("Situacao atualizada para %s.\n", SITUACAO[acoes[pos].situacao]);
}

void gerarResumo(Acao acoes[], int total) {
    int porSituacao[4] = {0}, porTema[6] = {0}, previstos = 0, presentes = 0;
    for (int i = 0; i < total; i++) {
        porSituacao[acoes[i].situacao]++;
        porTema[acoes[i].tema]++;
        if (acoes[i].situacao == 2) {
            previstos += acoes[i].previstos;
            presentes += acoes[i].presentes;
        }
    }
    printf("\n===== RESUMO GERAL =====\n");
    for (int s = 1; s <= 3; s++) printf("Acoes %-10s: %d\n", SITUACAO[s], porSituacao[s]);
    printf("Acoes por tema:\n");
    for (int t = 1; t <= 5; t++) printf("  %-21s %d\n", TEMAS[t], porTema[t]);
    printf("Total de participantes nas acoes realizadas: %d\n", presentes);
    if (previstos > 0)
        printf("Percentual de participacao: %.1f%%\n", presentes * 100.0 / previstos);
    else
        printf("Percentual de participacao: sem acoes realizadas.\n");
}

int main(void) {
    Acao acoes[MAX_ACOES];
    int total = 0, opcao = -1;
    while (opcao != 0) {
        printf("\n===== MENTE EM FOCO - PSE =====\n");
        printf("1 - Cadastrar acao\n2 - Listar acoes\n3 - Pesquisar por escola\n");
        printf("4 - Atualizar situacao\n5 - Resumo geral\n0 - Sair\n");
        opcao = lerNumero("Escolha uma opcao: ", 0, 5);
        switch (opcao) {
            case 1: total = cadastrarAcao(acoes, total); break;
            case 2: listarAcoes(acoes, total); break;
            case 3: pesquisarPorEscola(acoes, total); break;
            case 4: atualizarSituacao(acoes, total); break;
            case 5: gerarResumo(acoes, total); break;
            case 0: printf("Encerrando o sistema. Ate logo!\n"); break;
        }
    }
    return 0;
}
